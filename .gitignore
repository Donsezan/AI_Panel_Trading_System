# Secrets and local state — never commit
.env
.env.*
!.env.example
*.db
*.db-wal
*.db-shm
data/

# Generated validation reports. A signed promotion report belongs wherever the decision it
# justified is filed, not in the tree it was generated from (PLAN Phase 7).
reports/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.json
htmlcov/

# Editors
.vscode/
.idea/

# Agent scratch: per-plan ledgers, task briefs, review packages. Recoverable from git history,
# so it is never committed.
.superpowers/
